            "description": "non-null observations (country-years)"
          },
          "first_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Year"
          },
          "last_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Year"
          },
          "share": {
            "type": "number",
            "title": "Share",
            "description": "share of sample years (1990-2023) with data, 0-1"

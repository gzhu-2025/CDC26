          }
        },
        "type": "object",
        "required": [
          "year",
          "gdp_pc_gap_pct",
          "cumulative_gdp_pc_loss_usd",
          "fdi_gap_pp",
          "poverty_rate_gap_pp",
          "extra_people_in_poverty"
        ],
        "title": "Headline"
      },
      "History": {
        "properties": {
          "iso3": {
            "type": "string",
            "title": "Iso3"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "years": {
            "items": {
              "type": "integer"
            },

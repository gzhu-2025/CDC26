            "type": "array",
            "title": "Warnings"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "coverage",
          "warnings",
          "meta"
        ],
        "title": "Envelope[Diagnostics]"
      },
      "Envelope_History_": {
        "properties": {

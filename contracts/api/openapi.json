{
  "openapi": "3.1.0",
  "info": {
    "title": "Conflict Economic Impact Simulator",
    "description": "Local-projection estimates of how armed conflict is associated with GDP per capita, FDI and poverty, plus a Monte Carlo scenario simulator. Estimates are associational, not causal.",
    "version": "0.1.0"
  },
  "paths": {
    "/countries": {
      "get": {
        "summary": "Countries",
        "operationId": "countries_countries_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_list_CountryInfo__"
                }
              }
            }
          }
        }
      }
    },
    "/history/{iso3}": {
      "get": {
        "summary": "History",
        "operationId": "history_history__iso3__get",
        "parameters": [
          {
            "name": "iso3",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Iso3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_History_"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/simulate": {
      "post": {
        "summary": "Simulate",
        "operationId": "simulate_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_SimulationResult_"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/diagnostics/{outcome}": {
      "get": {
        "summary": "Diagnostics",
        "operationId": "diagnostics_diagnostics__outcome__get",
        "parameters": [
          {
            "name": "outcome",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "gdp",
                "fdi"
              ],
              "type": "string",
              "title": "Outcome"
            }
          },
          {
            "name": "measure",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "continuous",
                "onset"
              ],
              "type": "string",
              "default": "continuous",
              "title": "Measure"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_Diagnostics_"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/presets": {
      "get": {
        "summary": "Presets",
        "description": "Real past wars as reference scenarios, with intensity measured from the data.",
        "operationId": "presets_presets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_list_Preset__"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BacktestSummary": {
        "properties": {
          "n_episodes": {
            "type": "integer",
            "title": "N Episodes",
            "description": "past wars replayed"
          },
          "hit_rate_90": {
            "type": "number",
            "title": "Hit Rate 90",
            "description": "share whose actual GDP fell inside the 90% range"
          },
          "median_abs_log_err": {
            "type": "number",
            "title": "Median Abs Log Err"
          },
          "median_abs_log_err_no_war_model": {
            "type": "number",
            "title": "Median Abs Log Err No War Model",
            "description": "same error for a model that assumes the war had no effect"
          }
        },
        "type": "object",
        "required": [
          "n_episodes",
          "hit_rate_90",
          "median_abs_log_err",
          "median_abs_log_err_no_war_model"
        ],
        "title": "BacktestSummary"
      },
      "Band": {
        "properties": {
          "p5": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "P5"
          },
          "p25": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "P25"
          },
          "p50": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "P50"
          },
          "p75": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "P75"
          },
          "p95": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "P95"
          }
        },
        "type": "object",
        "required": [
          "p5",
          "p25",
          "p50",
          "p75",
          "p95"
        ],
        "title": "Band"
      },
      "BaselineAssumptions": {
        "properties": {
          "anchor_year": {
            "type": "integer",
            "title": "Anchor Year"
          },
          "gdp_growth_pct": {
            "type": "number",
            "title": "Gdp Growth Pct"
          },
          "gdp_growth_sd_pct": {
            "type": "number",
            "title": "Gdp Growth Sd Pct"
          },
          "fdi_level_pct_gdp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fdi Level Pct Gdp"
          },
          "poverty_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poverty Rate"
          },
          "poverty_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poverty Year"
          },
          "population": {
            "type": "number",
            "title": "Population"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "how the no-war path was forecast"
          }
        },
        "type": "object",
        "required": [
          "anchor_year",
          "gdp_growth_pct",
          "gdp_growth_sd_pct",
          "fdi_level_pct_gdp",
          "poverty_rate",
          "poverty_year",
          "population",
          "method"
        ],
        "title": "BaselineAssumptions"
      },
      "CountryInfo": {
        "properties": {
          "iso3": {
            "type": "string",
            "title": "Iso3"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "income_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Income Level"
          },
          "in_estimation_sample": {
            "type": "boolean",
            "title": "In Estimation Sample"
          },
          "coverage": {
            "additionalProperties": {
              "$ref": "#/components/schemas/IndicatorCoverage"
            },
            "type": "object",
            "title": "Coverage"
          }
        },
        "type": "object",
        "required": [
          "iso3",
          "name",
          "in_estimation_sample",
          "coverage"
        ],
        "title": "CountryInfo"
      },
      "DiagnosticRow": {
        "properties": {
          "h": {
            "type": "integer",
            "title": "H"
          },
          "is_lead": {
            "type": "boolean",
            "title": "Is Lead",
            "description": "pre-trend placebo (h < 0); should be ~0"
          },
          "beta": {
            "type": "number",
            "title": "Beta"
          },
          "se": {
            "type": "number",
            "title": "Se"
          },
          "p_value": {
            "type": "number",
            "title": "P Value"
          },
          "ci_low": {
            "type": "number",
            "title": "Ci Low"
          },
          "ci_high": {
            "type": "number",
            "title": "Ci High"
          },
          "boot_ci_low": {
            "type": "number",
            "title": "Boot Ci Low"
          },
          "boot_ci_high": {
            "type": "number",
            "title": "Boot Ci High"
          },
          "nobs": {
            "type": "integer",
            "title": "Nobs"
          },
          "n_countries": {
            "type": "integer",
            "title": "N Countries"
          }
        },
        "type": "object",
        "required": [
          "h",
          "is_lead",
          "beta",
          "se",
          "p_value",
          "ci_low",
          "ci_high",
          "boot_ci_low",
          "boot_ci_high",
          "nobs",
          "n_countries"
        ],
        "title": "DiagnosticRow"
      },
      "Diagnostics": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "gdp",
              "fdi"
            ],
            "title": "Outcome"
          },
          "measure": {
            "type": "string",
            "enum": [
              "continuous",
              "onset"
            ],
            "title": "Measure"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "leads": {
            "items": {
              "$ref": "#/components/schemas/DiagnosticRow"
            },
            "type": "array",
            "title": "Leads"
          },
          "path": {
            "items": {
              "$ref": "#/components/schemas/DiagnosticRow"
            },
            "type": "array",
            "title": "Path"
          },
          "sanity": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sanity"
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "measure",
          "unit",
          "leads",
          "path"
        ],
        "title": "Diagnostics"
      },
      "Envelope_Diagnostics_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Diagnostics"
          },
          "coverage": {
            "additionalProperties": {
              "$ref": "#/components/schemas/IndicatorCoverage"
            },
            "type": "object",
            "title": "Coverage",
            "description": "keyed by WB indicator code"
          },
          "warnings": {
            "items": {

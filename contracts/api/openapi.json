            },
            "type": "object",
            "title": "Coverage",
            "description": "keyed by WB indicator code"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warn"
            },
            "type": "array",
            "title": "Warnings"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "coverage",
          "warnings",
          "meta"
        ],
        "title": "Envelope[History]"

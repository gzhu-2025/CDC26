          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Headline": {
        "properties": {
          "year": {
            "type": "integer",
            "title": "Year",
            "description": "final simulated year (onset_year + horizon)"
          },
          "gdp_pc_gap_pct": {
            "$ref": "#/components/schemas/Quantiles"
          },
          "cumulative_gdp_pc_loss_usd": {
            "$ref": "#/components/schemas/Quantiles"
          },
          "fdi_gap_pp": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quantiles"
              },
              {
                "type": "null"
              }
            ]
          },
          "poverty_rate_gap_pp": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quantiles"
              },
              {
                "type": "null"
              }
            ]
          },
          "extra_people_in_poverty": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quantiles"
              },

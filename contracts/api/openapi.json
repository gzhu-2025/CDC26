          },
          "fdi_pct_gdp": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Fdi Pct Gdp"
          },
          "fdi_pct_gdp_ma3": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Fdi Pct Gdp Ma3",
